\DeclareDatamodelEntrytypes{onlinelexikon, zeitschriftartikel, onlinedokument, Booknew}

\DeclareDatamodelFields[type=field, datatype=date, skipout=false]{%
  lasteditdate,}

%Ausgabe im Quellenverzeichnis nach CZG-Vorgabe ("Hinweise zum Erstellen der
%Seminarfacharbeit", März 2024):
%  Buch:        Familienname, Vorname (Jahr): Titel. Untertitel. 2. Aufl. Ort: Verlag.
%  Zeitschrift: Familienname, Vorname / Familienname, Vorname (Jahr): Titel. In: Zeitschrift, Jg.Heft, S. x–y.
%  Online:      Familienname, Vorname (Jahr): Titel. URL [Abrufdatum TT.MM.JJJJ].
%               Institution. Titel. URL [Abrufdatum TT.MM.JJJJ].
%  Lexikon:     Stichwort (Datum der letzten Änderung). In: Lexikon. URL [Abrufdatum TT.MM.JJJJ].

\DeclareBibliographyDriver{onlinelexikon}{%
  \usebibmacro{bibindex}%
  \printfield{title}%
  \setunit{\addspace}\printlasteditdate%
  \setunit{\adddot\space}\printtext{In:}%
  \setunit{\space}\printfield{journaltitle}%
  \setunit{\adddot\space}\printfield{url}%
  \setunit{\addspace}\printurldate%
  \finentry}

\DeclareBibliographyDriver{zeitschriftartikel}{%
  \usebibmacro{bibindex}%
  \printnames{author}%
  \setunit{\addspace}\printfield{year}%
  \setunit{\addcolon\space}\printfield{title}%
  \setunit{\adddot\space}\printtext{In:}%
  \setunit{\space}\printfield{journaltitle}%
  \setunit{\addcomma\space}%
  \iffieldundef{volume}{}{\printtext{\thefield{volume}\iffieldundef{number}{}{.\thefield{number}}}}%
  \setunit{\addcomma\space}\printfield{pages}%
  \setunit{\adddot\space}\printfield{url}%
  \setunit{\addspace}\printurldate%
  \finentry}

\DeclareBibliographyDriver{onlinedokument}{%
  \usebibmacro{bibindex}%
  \printnames{author}%
  \iffieldundef{year}
    {\setunit{\adddot\space}}
    {\setunit{\addspace}\printfield{year}\setunit{\addcolon\space}}%
  \printfield{title}%
  \setunit{\adddot\space}\printfield{subtitle}%
  \setunit{\adddot\space}\printfield{note}%
  \setunit{\adddot\space}\printfield{url}%
  \setunit{\addspace}\printurldate%
  \finentry}

\DeclareBibliographyDriver{Booknew}{%
  \usebibmacro{bibindex}%
  \printnames{author}%
  \setunit{\addspace}\printfield{year}%
  \setunit{\addcolon\space}\printfield{title}%
  \setunit{\adddot\space}\printfield{subtitle}%
  \setunit{\adddot\space}\printfield{edition}%
  \setunit{\adddot\space}\printlist{location}%
  \iflistundef{location}{\setunit{\adddot\space}}{\setunit{\addcolon\space}}%
  \printlist{publisher}%
  \setunit{\adddot\space}\printfield{url}%
  \setunit{\addspace}\printurldate%
  \finentry}
